# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32

# --- Domains -------------------------------------------------------------
# Used for TLS (edge profile) and for the URLs pretix and n8n advertise.
PRETIX_DOMAIN=events.example.com
N8N_DOMAIN=n8n.example.com
ACME_EMAIL=ops@example.com

# --- Database ------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
PRETIX_DB_PASSWORD=
N8N_DB_PASSWORD=

# --- n8n -----------------------------------------------------------------
# Encrypts stored credentials. Lose it and every credential must be re-entered.
N8N_ENCRYPTION_KEY=
# Number of reverse proxies in front of n8n. 1 for Caddy or a single nginx.
N8N_PROXY_HOPS=1
# Hours of execution history to keep. WhatsApp status webhooks are high volume.
N8N_EXECUTION_RETENTION_HOURS=720
N8N_SAVE_ON_SUCCESS=all

# --- General -------------------------------------------------------------
TZ=Asia/Kolkata
# Seconds between pretix cron runs. Docs recommend 900 to 2700.
PRETIX_CRON_INTERVAL=900

# --- Workflows -----------------------------------------------------------
# Signs broker registration links. openssl rand -hex 32
BROKER_LINK_SECRET=
# Where n8n reaches pretix on the compose network. Leave as-is normally.
PRETIX_API_BASE=http://pretix:80/api/v1
# Host header for those calls. Must equal the domain in pretix.cfg's url setting.
PRETIX_HOST=events.jslwealth.in
PRETIX_ORGANIZER=jsl
PRETIX_EVENT=investor-events

# ---------------------------------------------------------------- portal
# The broker, admin and door screens. Everything a human waits on is served
# here; anything on a clock stays in n8n.
PORTAL_PORT=8090
# 5433 is already used by another stack on jprod.
POSTGRES_PORT=5434
# Public origin, used when minting signed links with portal/issue-link.py.
PORTAL_BASE=https://events.jslwealth.in

# Directory database password. Generate with: openssl rand -hex 24
DIRECTORY_DB_PASSWORD=

# Pretix API token for the portal. Create it under the organizer's team
# settings with orders read/write and checkin permissions.
PRETIX_API_TOKEN=

# WATI. The token is a secret; keep this file out of git (it already is).
WATI_API_BASE=https://live-mt-server.wati.io/<tenant-id>
WATI_TOKEN=
WATI_TEMPLATE=jsl_event_v3

# ZeptoMail. ZEPTO_SMTP_PASS is the same value the HTTPS API takes as
# "Zoho-enczapikey <key>". India data centre: api.zeptomail.in.
ZEPTO_SMTP_PASS=
MAIL_FROM=events@jslwealth.in
MAIL_FROM_NAME=Jhaveri Securities

# Where a recipient's QR is rendered. The approved WhatsApp template stores a
# bare variable for the whole URL, so this can be repointed at our own
# endpoint without a new Meta review.
QR_BASE=https://api.qrserver.com/v1/create-qr-code/?size=600x600&margin=20&data=
