; Copy to pretix.cfg and fill in. Never commit pretix.cfg.
; Reference: https://docs.pretix.eu/self-hosting/installation/docker_smallscale/

[pretix]
instance_name=JSL Wealth Events
url=https://events.example.com
currency=INR
datadir=/data
trust_x_forwarded_for=on
trust_x_forwarded_proto=on

[database]
backend=postgresql
name=pretix
user=pretix
password=CHANGEME
host=postgres
port=5432

[redis]
location=redis://redis:6379/0
sessions=true

[celery]
backend=redis://redis:6379/1
broker=redis://redis:6379/2

[mail]
; ZeptoMail: host smtp.zeptomail.com, port 587 with tls (or 465 with ssl).
; The username is the literal string "emailapikey", not an address. The
; password is the send-mail token from the ZeptoMail console. "from" must be a
; sender ZeptoMail has verified for the domain.
; If JSL is on Zoho's India data centre, check the console's Setup Info for a
; region-specific host before using the default below.
from=events@example.com
host=smtp.zeptomail.com
user=emailapikey
password=
port=587
tls=on
ssl=off

[locale]
default=en
timezone=Asia/Kolkata
