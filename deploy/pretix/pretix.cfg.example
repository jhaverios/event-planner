; Copy to pretix.cfg and fill in. Never commit pretix.cfg.
; Reference: https://docs.pretix.eu/self-hosting/installation/docker_smallscale/

[pretix]
instance_name=JSL Wealth Events
url=https://events.example.com
currency=INR
datadir=/data
trust_x_forwarded_for=on
trust_x_forwarded_proto=on

[database]
backend=postgresql
name=pretix
user=pretix
password=CHANGEME
host=postgres
port=5432

[redis]
location=redis://redis:6379/0
sessions=true

[celery]
backend=redis://redis:6379/1
broker=redis://redis:6379/2

[mail]
; ZeptoMail. JSL is on Zoho's INDIA data centre, proven rather than assumed:
; the same token returns a validation error on api.zeptomail.in and
; 401 "Invalid API Token" on api.zeptomail.com. Using the global host fails in a
; way that looks like a bad password rather than a wrong region.
;
; Username is the literal string "emailapikey", not an address. The password is
; the send-mail token from the agent's SMTP page. "from" must be on a domain
; ZeptoMail has verified.
from=events@jslwealth.in
host=smtp.zeptomail.in
user=emailapikey
password=
port=587
tls=on
ssl=off

[locale]
default=en
timezone=Asia/Kolkata
